# AI Mall Platform 环境变量模板 (请复制为 .env 并填入个人真实密钥)
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
CHAT_MODEL=qwen3.7-flash
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
PG_USER=postgres
PG_PASSWORD=aimall123

# 必填：JWT 签名密钥，至少 32 个字符，所有微服务使用同一个值。
# 仓库不再提供默认值（公开的默认密钥等于任何人都能伪造登录凭证），未设置时服务启动失败。
# 生成方式：openssl rand -base64 48
# 本机直接运行 jar / IDE 时，把它设成系统环境变量即可，所有服务都会读取。
JWT_SECRET=

# 可选：服务间 Feign 调用凭证。不设置时由 JWT_SECRET 自动派生，一般不用填。
# INTERNAL_RPC_TOKEN=
